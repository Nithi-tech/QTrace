# Copy to .env and fill in real values. Never commit .env (CLAUDE.md #18, #46).

DATABASE_URL=postgresql+psycopg://qtrace:qtrace@localhost:5432/qtrace
REDIS_URL=redis://localhost:6379/0

# Public OSRM demo server - free, no download/self-hosting required for development,
# but rate-limited and not for production load. Point this at a self-hosted OSRM
# server for production (docs/OSRM_INTEGRATION.md).
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving

# "tomtom" (requires TOMTOM_API_KEY) or "nominatim" (keyless, OpenStreetMap data).
GEOCODING_PROVIDER=tomtom
TOMTOM_API_KEY=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

SECRET_KEY=

ROUTING_REQUEST_TIMEOUT_SECONDS=5.0
ROUTING_MAX_RETRIES=2
MAX_ROUTE_STOPS=25

# QTrace crowd-traffic system (docs/TRAFFIC_ARCHITECTURE.md) - QTrace's own anonymized
# GPS telemetry, map-matched against OSRM. No commercial traffic API required.
TRAFFIC_ENABLED=true
TRAFFIC_TELEMETRY_INGESTION_ENABLED=true

# Freshness thresholds - never labeled LIVE/RECENT past these ages.
TRAFFIC_LIVE_TTL_SECONDS=120.0
TRAFFIC_RECENT_TTL_SECONDS=300.0
TRAFFIC_EXPIRED_SECONDS=900.0

# A segment's snapshot isn't trusted until at least this many observations back it.
TRAFFIC_MIN_OBSERVATIONS=3

# Corridor width (meters) used to match stop-pairs to nearby segments.
TRAFFIC_CORRIDOR_RADIUS_METERS=100.0

# Retention: raw GPS-derived observations are kept briefly; the derived historical
# baseline is kept long-term.
TRAFFIC_RAW_RETENTION_DAYS=7
TRAFFIC_SNAPSHOT_RETENTION_DAYS=30

# Server-side cap on one ingestion request's observation count.
TRAFFIC_MAX_BATCH_SIZE=500

# QPSO fitness weights (CLAUDE.md #9) - tunable starting values, not a proven-optimal
# combination. Need not sum to 1; only relative magnitude matters to QPSO.
DISTANCE_WEIGHT=0.4
TIME_WEIGHT=0.4
TRAFFIC_WEIGHT=0.2
