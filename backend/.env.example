# Copy to .env and fill in real values. Never commit .env (CLAUDE.md #18, #46).

DATABASE_URL=postgresql+psycopg://qtrace:qtrace@localhost:5432/qtrace
REDIS_URL=redis://localhost:6379/0

# Public OSRM demo server - free, no download/self-hosting required for development,
# but rate-limited and not for production load. Point this at a self-hosted OSRM
# server for production (docs/OSRM_INTEGRATION.md).
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving

# "tomtom" (requires TOMTOM_API_KEY) or "nominatim" (keyless, OpenStreetMap data).
GEOCODING_PROVIDER=tomtom
TOMTOM_API_KEY=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

SECRET_KEY=

ROUTING_REQUEST_TIMEOUT_SECONDS=5.0
ROUTING_MAX_RETRIES=2
MAX_ROUTE_STOPS=25

# Real-time traffic intelligence (docs/TRAFFIC_ARCHITECTURE.md). Fallback order:
# TomTom live -> QTrace crowd telemetry -> historical baseline -> unavailable.
# Reuses TOMTOM_API_KEY above - never a second/duplicate TomTom credential.
TRAFFIC_ENABLED=true
TRAFFIC_TELEMETRY_INGESTION_ENABLED=true

TRAFFIC_TIMEOUT_SECONDS=5.0
TRAFFIC_MAX_RETRIES=2
# TomTom flow/incident responses are cached in-process (no Redis client exists yet in
# this codebase - a Redis-backed cache is a documented follow-up, not built in this pass).
TRAFFIC_CACHE_TTL_SECONDS=60.0

# Freshness thresholds (seconds) - never labeled LIVE/RECENT past these ages.
TRAFFIC_LIVE_TTL_SECONDS=120.0
TRAFFIC_RECENT_TTL_SECONDS=300.0
TRAFFIC_EXPIRED_SECONDS=900.0

# A crowd-telemetry segment's snapshot isn't trusted until this many independent observations back it.
TRAFFIC_MIN_OBSERVATIONS=3

# Corridor width (meters) used to match a stop-pair to nearby crowd segments/incidents.
TRAFFIC_CORRIDOR_RADIUS_METERS=150.0

TRAFFIC_RAW_RETENTION_DAYS=7
TRAFFIC_SNAPSHOT_RETENTION_DAYS=30
TRAFFIC_MAX_BATCH_SIZE=500

# QPSO fitness weights - tunable starting values, not a proven-optimal combination.
# Need not sum to 1; only relative magnitude matters to QPSO.
DISTANCE_WEIGHT=0.4
TIME_WEIGHT=0.4
TRAFFIC_WEIGHT=0.2

# Map traffic layer (GET /api/v1/traffic/area) - Google-Maps-style colored roads.
# TomTom's flow API has no bbox endpoint, so a capped grid of point samples covers the
# viewport instead; both bounds below exist purely for API cost control.
TRAFFIC_AREA_MAX_POINTS=36
TRAFFIC_AREA_MAX_SPAN_DEGREES=0.25

# 5-level map visualization thresholds on speed_ratio (current/free-flow) - QTrace's own
# classification, not any provider's or Google's.
TRAFFIC_MAP_GREEN_THRESHOLD=0.80
TRAFFIC_MAP_YELLOW_THRESHOLD=0.60
TRAFFIC_MAP_ORANGE_THRESHOLD=0.40
TRAFFIC_MAP_RED_THRESHOLD=0.20
